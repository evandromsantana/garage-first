generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
  inventoryItems InventoryItem[]
}

model Vehicle {
  id          String   @id @default(uuid())
  ownerName   String?
  brand       String?
  model       String
  year        Int
  plate       String?
  renavam     String?
  chassis     String?
  engineNumber String?
  color       String?
  uf          String?
  currentKm   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenanceLogs MaintenanceLog[]
  technicalSpecs  TechnicalSpec[]
}

model MaintenanceLog {
  id            String   @id @default(uuid())
  vehicleId     String
  type          String   // PREVENTIVE, CORRECTIVE, UPGRADE
  description   String
  kmAtService   Int
  cost          Float?
  status        String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  diagramCode   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  expenses      ProjectExpense[]
}

model ProjectExpense {
  id              String   @id @default(uuid())
  maintenanceId   String
  itemName        String
  itemCost        Float
  isOriginalPart  Boolean  @default(false)
  createdAt       DateTime @default(now())

  maintenanceLog  MaintenanceLog @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
}

model TechnicalSpec {
  id          String   @id @default(uuid())
  vehicleId   String
  category    String   // TORQUE, PRESSURE, CAPACITY, FLUID
  component   String
  value       String
  notes       String?
  diagramCode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id            String   @id @default(uuid())
  name          String
  quantity      Int      @default(0)
  minQuantity   Int      @default(1)
  category      String   // CONSUMABLE, PART, TOOL
  price         Float?
  location      String?  // Ex: Prateleira A, Gaveta 2
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
